 		// AI_AB_TEST (strike; Economy's bans): a declaration of ours (HasStrikeDeclared)
 		if (kMyTeam.isAtWar(eTheirTeam))
-			m_pPlayer->GetMilitaryAI()->SetStrikeDeclared();
+			m_pPlayer->GetMilitaryAI()->SetStrikeDeclared(ePlayer);
