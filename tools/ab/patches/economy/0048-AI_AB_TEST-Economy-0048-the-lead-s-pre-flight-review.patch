 	bool IsLateStrikeCiv() const; // AI_AB_TEST Economy, flag LateStrike: a warmonger with a late spike and a strike plan
 	bool IsLateStrikeSaving() const; // AI_AB_TEST Economy, flag LateStrike: from the build-up to the declaration, gold kept for upgrades
 	bool IsStrikePending() const; // AI_AB_TEST Economy, flags EarlyStrike/LateStrike (0040): a strike civ before its strike (state PREP or BUILDUP) // AI_AB_TEST Economy, flag LateStrike: from the build-up to the declaration, gold kept for upgrades
-	bool IsLateStrikePrepSaving() const; // AI_AB_TEST Economy 0046: a late strike's PREP with all but the gold of its BUILDUP condition met
+	bool IsLateStrikeUnitHold() const; // AI_AB_TEST Economy 0046/0048: a late strike's PREP with net gold under +2: no new combat unit
 	bool IsStrikeNoWonders() const; // AI_AB_TEST Economy 0042: no world or national wonder now (a strike civ before its strike)
 	const CvStrikePlan* GetStrikeListPlan() const; // AI_AB_TEST Economy, flag StrikeList: the strike plan while its lists run
 	bool GetStrikeListProduction(CvCity* pCity, OrderTypes& eOrder, int& iData, bool& bListRuns); // flag StrikeList: the next list item
diff --git a/CvGameCoreDLL_Expansion2/CvUnitProductionAI.cpp b/CvGameCoreDLL_Expansion2/CvUnitProductionAI.cpp
index a6429b2..b978d1c 100644
--- a/CvGameCoreDLL_Expansion2/CvUnitProductionAI.cpp
+++ b/CvGameCoreDLL_Expansion2/CvUnitProductionAI.cpp
@@ -207,6 +207,12 @@ int CvUnitProductionAI::CheckUnitBuildSanity(UnitTypes eUnit, bool bForOperation
 	// AI_AB_TEST (candidate, flag ArmyQuality, War): a timing attacker builds no land combat unit (not scouts or siege) weaker
 	// than 70% of the best one it can train, unless the city is under siege; such units no longer count toward the army
 	// (CvMilitaryAI::IsArmyQualityUnit). 22% of BigArmy's first-declaration armies were Warriors and Scouts.
+	// AI_AB_TEST (LateStrike, Economy 0048): a late strike's PREP is economy first. No new combat unit while net gold is under
+	// +2 a turn, unless the city is in danger (CvPlayer::IsLateStrikeUnitHold)
+	if (bCombat && !bFree && !bDesperate && pkUnitEntry->GetDefaultUnitAIType() != UNITAI_EXPLORE &&
+		kPlayer.IsLateStrikeUnitHold() && !m_pCity->isInDangerOfFalling())
+		return SR_STRATEGY;
+
 	if (bCombat && !bFree && !bDesperate && pkUnitEntry->GetDomainType() == DOMAIN_LAND && pkUnitEntry->GetDefaultUnitAIType() != UNITAI_EXPLORE &&
 		pkUnitEntry->GetDefaultUnitAIType() != UNITAI_CITY_BOMBARD && kPlayer.UsesCandidateAI(FIX_ARMY_QUALITY) &&
 		kPlayer.GetMilitaryAI()->IsTimingBuildupPlayer() && !kPlayer.GetMilitaryAI()->IsArmyQualityUnit(pkUnitEntry))
