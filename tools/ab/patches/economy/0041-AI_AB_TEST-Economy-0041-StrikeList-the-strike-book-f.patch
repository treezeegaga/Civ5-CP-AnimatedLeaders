 /// scaled to the game speed at the end. The research's general rules: Archer to Composite Bowman "upgrade and go" at
 /// Construction with 70-80 gold saved per Archer; at least 2 melee units to take a city; 2-3 cities before the strike.
+/// AI_AB_TEST (flag StrikeList, Economy): fill the strike plan's expert lists, in order
+bool CvStrikePlan::AddBuild(const char* szClass, int iCount)
+{
+	if (!szClass || iNumBuild >= STRIKE_LIST_MAX_BUILD || iCount < 1)
+		return false;
+	const bool bUnit = strncmp(szClass, "UNITCLASS_", 10) == 0;
+	const int iClass = GC.getInfoTypeForString(szClass, true);
+	if (iClass < 0 || (!bUnit && strncmp(szClass, "BUILDINGCLASS_", 14) != 0))
+		return false;
+	aBuild[iNumBuild].bUnit = bUnit;
+	aBuild[iNumBuild].iClass = iClass;
+	aBuild[iNumBuild].iCount = bUnit ? iCount : 1;
+	iNumBuild++;
+	return true;
+}
+bool CvStrikePlan::AddTech(const char* szTech)
+{
+	const TechTypes eTech = szTech ? (TechTypes)GC.getInfoTypeForString(szTech, true) : NO_TECH;
+	if (eTech == NO_TECH || iNumTech >= STRIKE_LIST_MAX_TECH)
+		return false;
+	aTech[iNumTech++] = eTech;
+	return true;
+}
+bool CvStrikePlan::AddPolicy(const char* szPolicy)
+{
+	const PolicyTypes ePolicy = szPolicy ? (PolicyTypes)GC.getInfoTypeForString(szPolicy, true) : NO_POLICY;
+	if (ePolicy == NO_POLICY || iNumPolicy >= STRIKE_LIST_MAX_POLICY)
+		return false;
+	aPolicy[iNumPolicy++] = ePolicy;
+	return true;
+}
