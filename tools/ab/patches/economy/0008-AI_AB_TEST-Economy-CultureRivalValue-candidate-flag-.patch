Subject: [PATCH 8/8] AI_AB_TEST Economy: CultureRivalValue candidate flag (E2:
 dead IsPlayerValid loop meant to value culture more when rivals' tourism
 gains)

Not in the bundle.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G2NZj2nf4FeZTEHWjvnhhA
---
 CvGameCoreDLL_Expansion2/CvCityStrategyAI.cpp | 5 ++++-
 CvGameCoreDLL_Expansion2/CvPlayer.cpp         | 7 ++++---
 CvGameCoreDLL_Expansion2/CvPlayer.h           | 1 +
 3 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/CvGameCoreDLL_Expansion2/CvCityStrategyAI.cpp b/CvGameCoreDLL_Expansion2/CvCityStrategyAI.cpp
index 9822e86..79cecf0 100644
--- a/CvGameCoreDLL_Expansion2/CvCityStrategyAI.cpp
+++ b/CvGameCoreDLL_Expansion2/CvCityStrategyAI.cpp
@@ -4300,7 +4300,10 @@ int CityStrategyAIHelpers::GetBuildingYieldValue(CvCity *pCity, BuildingTypes eB
 			{
 				PlayerTypes eLoopPlayer = (PlayerTypes)iPlayerLoop;
 
-				if (eLoopPlayer != NO_PLAYER && eLoopPlayer != kPlayer.GetID() && GET_PLAYER(eLoopPlayer).GetDiplomacyAI()->IsPlayerValid(eLoopPlayer) && !GET_PLAYER(eLoopPlayer).isMinorCiv())
+				// AI_AB_TEST candidate (CultureRivalValue): CP asks the rival whether it is valid to itself, which is always false
+				// (IsPlayerValid rejects one's own team), so no rival multiplier ever applied, in CP or B
+				CvDiplomacyAI* pValidator = kPlayer.UsesCandidateAI(FIX_CULTURE_RIVAL_VALUE) ? kPlayer.GetDiplomacyAI() : GET_PLAYER(eLoopPlayer).GetDiplomacyAI();
+				if (eLoopPlayer != NO_PLAYER && eLoopPlayer != kPlayer.GetID() && pValidator->IsPlayerValid(eLoopPlayer) && !GET_PLAYER(eLoopPlayer).isMinorCiv())
 				{
 					int iRivalMultiplier = 1;
 					if (GET_PLAYER(eLoopPlayer).GetDiplomacyAI()->IsCloseToCultureVictory())
diff --git a/CvGameCoreDLL_Expansion2/CvPlayer.cpp b/CvGameCoreDLL_Expansion2/CvPlayer.cpp
index aa8a800..fb8928e 100644
--- a/CvGameCoreDLL_Expansion2/CvPlayer.cpp
+++ b/CvGameCoreDLL_Expansion2/CvPlayer.cpp
@@ -33322,18 +33322,19 @@ static const char* const kCandidateFixNames[NUM_CANDIDATE_FIXES] = {
 	"WidePlans", "BoxedIn", "LongWide", "BoxedInWar", "TimingAttack", "SiegeTechs", "SiegeBook", "DeclareTiming",
 	"GrowthTech", "AqueductValue", "GreedyArmyCap", "GreedyBook", "GreedyTarget", "CanWin", "ClosedBorders",
 	"SettlersFirst", "SettlerOverlap", "DiploPolicyValue", "GreedyAlarm", "IdeologyPick", "PolicyPrereqDepth",
-	"EspionagePolicyValue", "LosingWarBuildings" };
+	"EspionagePolicyValue", "LosingWarBuildings", "CultureRivalValue" };
 
 // The bundle: what group c ran in the last C build (c7c), and what every civ runs outside a test game. Off in it:
 // LongWide (c1: c's wide civs got no more cities from the longer opening, and stopping settlers ended expansion that b
 // completed) and GreedyArmyCap (c6, 0-3: the greedy tall civs drew wars). Flags added after c7c stay out until they pass,
 // so a game without AIABTest.ini still plays c7c: SettlersFirst, SettlerOverlap, DiploPolicyValue,
 // GreedyAlarm, IdeologyPick, PolicyPrereqDepth, EspionagePolicyValue,
-// LosingWarBuildings.
+// LosingWarBuildings, CultureRivalValue.
 static const int kCandidateFixBundle = ~((1 << FIX_LONG_WIDE) | (1 << FIX_GREEDY_ARMY_CAP) | (1 << FIX_SETTLERS_FIRST) |
 	(1 << FIX_SETTLER_OVERLAP) | (1 << FIX_DIPLO_POLICY_VALUE) | (1 << FIX_GREEDY_ALARM) |
 	(1 << FIX_IDEOLOGY_PICK) | (1 << FIX_POLICY_PREREQ_DEPTH) |
-	(1 << FIX_ESPIONAGE_POLICY_VALUE) | (1 << FIX_LOSING_WAR_BUILDINGS)) & ((1 << NUM_CANDIDATE_FIXES) - 1);
+	(1 << FIX_ESPIONAGE_POLICY_VALUE) | (1 << FIX_LOSING_WAR_BUILDINGS) |
+	(1 << FIX_CULTURE_RIVAL_VALUE)) & ((1 << NUM_CANDIDATE_FIXES) - 1);
 
 const char* CvPlayer::GetCandidateFixName(int iFix)
 {
diff --git a/CvGameCoreDLL_Expansion2/CvPlayer.h b/CvGameCoreDLL_Expansion2/CvPlayer.h
index 3c99f94..4c1a907 100644
--- a/CvGameCoreDLL_Expansion2/CvPlayer.h
+++ b/CvGameCoreDLL_Expansion2/CvPlayer.h
@@ -167,6 +167,7 @@ enum CandidateFixTypes
 	FIX_POLICY_PREREQ_DEPTH,	// Economy (CvPolicyAI audit P3): policy weight passed to prerequisites at the right depth. Not in the bundle
 	FIX_ESPIONAGE_POLICY_VALUE,	// Economy (CvPolicyAI audit P4): the passive espionage bonus is scored by its own value. Not in the bundle
 	FIX_LOSING_WAR_BUILDINGS,	// Economy (E1): a civ losing a war cuts non-defensive buildings further, as CP meant (dead loop). Not in the bundle
+	FIX_CULTURE_RIVAL_VALUE,	// Economy (E2): culture is valued more when a rival's tourism gains on us, as CP meant (dead loop). Not in the bundle
 	NUM_CANDIDATE_FIXES
 };
 
