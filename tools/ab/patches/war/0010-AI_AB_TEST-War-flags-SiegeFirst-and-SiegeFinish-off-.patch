From 8c4730200fff627390162699870c775d6f318319 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 13:46:13 +0000
Subject: [PATCH] AI_AB_TEST War: flags SiegeFirst and SiegeFinish (off in the
 bundle)

- SiegeFirst (CvAIOperation::FindBestFitReserveUnit): while SiegeArmy holds
  an attack as too weak, its optional siege-first slots (UNITAI_CITY_BOMBARD
  primary) take only real siege units, from the operation's second turn and
  only if the civ can build one; the open slot then asks a city for a
  catapult. Composite bowmen filled those slots through their UNITAI_RANGED
  secondary type (bully pair 0B09BFE1: one siege unit per army).
- SiegeFinish (CvTacticalAI::ExecuteCaptureCityMoves): a city at a third of
  its HP or less is assaulted at high aggression even with 2 or fewer melee
  units in reach (Tiwanaku and Kyoto stopped at about 130/200 and healed).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G2NZizcmgfGkXsgJcVcF7h
---
 CvGameCoreDLL_Expansion2/CvAIOperation.cpp | 15 +++++++++++++++
 CvGameCoreDLL_Expansion2/CvPlayer.cpp      |  1 +
 CvGameCoreDLL_Expansion2/CvPlayer.h        |  2 ++
 CvGameCoreDLL_Expansion2/CvTacticalAI.cpp  |  7 ++++++-
 4 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/CvGameCoreDLL_Expansion2/CvAIOperation.cpp b/CvGameCoreDLL_Expansion2/CvAIOperation.cpp
index 149d12e85..1623132ad 100644
--- a/CvGameCoreDLL_Expansion2/CvAIOperation.cpp
+++ b/CvGameCoreDLL_Expansion2/CvAIOperation.cpp
@@ -26,6 +26,8 @@
 #include "FStlContainerSerialization.h"
 #include "CvDiplomacyAI.h"
 #include "CvTypes.h"
+#include "CvCityStrategyAI.h"
+#include "CvUnitProductionAI.h"
 
 #define LINT_WARNINGS_ONLY
 #include "LintFree.h"
@@ -1444,12 +1446,25 @@ bool CvAIOperation::FindBestFitReserveUnit(OperationSlot thisOperationSlot, vect
 	}
 
 	CvFormationSlotEntry thisSlotEntry =  pThisArmy->GetSlotInfo(thisOperationSlot.m_iSlotID);
+	//AI_AB_TEST (candidate, flag SiegeFirst): only if the civ can build a siege unit at all
+	bool bSiegeOnly = false;
+	//optional slots only, and not on the creation turn (CvPlayer::addAIOperation aborts a new operation missing too many units)
+	if (ownerPlayer.UsesCandidateAI(FIX_SIEGE_FIRST) && thisSlotEntry.m_primaryUnitType == UNITAI_CITY_BOMBARD && !thisSlotEntry.m_requiredSlot &&
+		GC.getGame().getGameTurn() > GetTurnStarted() && IsArmyTooWeakForTarget(pThisArmy))
+	{
+		CvCity* pCapital = ownerPlayer.getCapitalCity();
+		bSiegeOnly = pCapital && pCapital->GetCityStrategyAI()->GetUnitProductionAI()->RecommendUnit(UNITAI_CITY_BOMBARD, true) != NO_UNIT;
+	}
 	for (size_t iI=0; iI<choices.size(); iI++)
 	{
 		CvUnit* pBestUnit = GET_PLAYER(m_eOwner).getUnit(choices[iI].option);
 		if (pBestUnit != NULL)
 		{
 			CvUnitEntry* unitInfo = GC.getUnitInfo(pBestUnit->getUnitType());
+			//AI_AB_TEST (candidate, flag SiegeFirst): while SiegeArmy holds this attack back, a siege-first slot takes only a real
+			//siege unit, so it stays open and a city is asked for a catapult (composite bowmen filled these slots in test games)
+			if (bSiegeOnly && thisSlotEntry.m_primaryUnitType == UNITAI_CITY_BOMBARD && !unitInfo->GetUnitAIType(UNITAI_CITY_BOMBARD))
+				continue;
 			if (unitInfo->GetUnitAIType(thisSlotEntry.m_primaryUnitType) || unitInfo->GetUnitAIType(thisSlotEntry.m_secondaryUnitType))
 			{
 				pThisArmy->AddUnit(pBestUnit->GetID(), thisOperationSlot.m_iSlotID, thisSlotEntry.m_requiredSlot);
diff --git a/CvGameCoreDLL_Expansion2/CvPlayer.cpp b/CvGameCoreDLL_Expansion2/CvPlayer.cpp
index a44ae862f..a13e57a9f 100644
--- a/CvGameCoreDLL_Expansion2/CvPlayer.cpp
+++ b/CvGameCoreDLL_Expansion2/CvPlayer.cpp
@@ -33357,6 +33357,7 @@ static const CandidateFixInfo kCandidateFixes[] = {
 	{"AggressivePlan", false}, {"AggressiveArmy", false}, {"BalancedArmy", false}, {"BalancedWalls", false},
 	{"MetaDial", false}, {"SiegeFormation", false},
 	{"StaleWarPeace", false}, {"WarAppetite", false},
+	{"SiegeFirst", false}, {"SiegeFinish", false},
 };
 // one line per flag, and room in the 64-bit masks
 typedef char ABTestFixTableMatchesEnum[(sizeof(kCandidateFixes) / sizeof(kCandidateFixes[0]) == NUM_CANDIDATE_FIXES) ? 1 : -1];
diff --git a/CvGameCoreDLL_Expansion2/CvPlayer.h b/CvGameCoreDLL_Expansion2/CvPlayer.h
index bf6948b79..caeb18d2b 100644
--- a/CvGameCoreDLL_Expansion2/CvPlayer.h
+++ b/CvGameCoreDLL_Expansion2/CvPlayer.h
@@ -221,6 +221,8 @@ enum CandidateFixTypes
 							// consider peace, no "they're in danger, hold out" term, progress penalty doubled. Off in the bundle
 	FIX_WAR_APPETITE,		// Diplomacy (Personality's profile): the WAR approach weight follows the meta position M: x0.5 at -100
 							// (greedy), x1 at 0, x2 at +100 (aggressive). Off in the bundle
+	FIX_SIEGE_FIRST,		// War: while SiegeArmy holds an attack, its siege-first slots take only siege units. Off in the bundle
+	FIX_SIEGE_FINISH,		// War: melee units assault a city at a third of its HP or less (high aggression). Off in the bundle
 	NUM_CANDIDATE_FIXES
 };
 // AI_AB_TEST: a set of candidate flags, bit i = CandidateFixTypes i
diff --git a/CvGameCoreDLL_Expansion2/CvTacticalAI.cpp b/CvGameCoreDLL_Expansion2/CvTacticalAI.cpp
index aa519ca1b..a79bcdaf5 100644
--- a/CvGameCoreDLL_Expansion2/CvTacticalAI.cpp
+++ b/CvGameCoreDLL_Expansion2/CvTacticalAI.cpp
@@ -976,7 +976,12 @@ void CvTacticalAI::ExecuteCaptureCityMoves(eAggressionLevel eMaxAggLvl)
 
 				//finally do the attack. be a bit more careful if we have few melee units
 				//AI_AB_TEST: eMaxAggLvl is AL_HIGH except for the SiegePosture flag's safe-shots-only call
-				ExecuteAttackWithUnits(pPlot, eMaxAggLvl < AL_HIGH ? eMaxAggLvl : (iMeleeCount>2 ? AL_HIGH : AL_MEDIUM));
+				eAggressionLevel eAggLvl = eMaxAggLvl < AL_HIGH ? eMaxAggLvl : (iMeleeCount>2 ? AL_HIGH : AL_MEDIUM);
+				//AI_AB_TEST (candidate, flag SiegeFinish): a city down to a third of its HP gets the melee assault (test sieges brought
+				//cities to about 130 of 200 and never went in, and the city healed back)
+				if (m_pPlayer->UsesCandidateAI(FIX_SIEGE_FINISH) && eMaxAggLvl == AL_HIGH && iMeleeCount > 0 && iRequiredDamage * 3 <= pCity->GetMaxHitPoints())
+					eAggLvl = AL_HIGH;
+				ExecuteAttackWithUnits(pPlot, eAggLvl);
 
 				// Did it work?  If so, don't need a temporary dominance zone if had one here
 				if (pPlot->getOwner() == m_pPlayer->GetID())
