From 5bfea3f3542260c468b631794823135988ee4d8c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 04:41:42 +0000
Subject: [PATCH] AI_AB_TEST War: flag SiegeAbort (an attack still too weak
 after SiegeArmy's 20 turns is called off; off in the bundle)

Bully conquest pair 0879B791: the Celts' sneak attack waited 20 turns at 27
of 60 a turn, then marched anyway, declared on an equal neighbour and lost
11 units for nothing. With SiegeAbort it ends instead; the WAR approach stays,
so a fresh attack must reach the bar before it can march or declare.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G2NZizcmgfGkXsgJcVcF7h
---
 CvGameCoreDLL_Expansion2/CvAIOperation.cpp | 15 +++++++++++++--
 CvGameCoreDLL_Expansion2/CvAIOperation.h   |  2 +-
 CvGameCoreDLL_Expansion2/CvPlayer.cpp      |  2 +-
 CvGameCoreDLL_Expansion2/CvPlayer.h        |  1 +
 4 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/CvGameCoreDLL_Expansion2/CvAIOperation.cpp b/CvGameCoreDLL_Expansion2/CvAIOperation.cpp
index 046d6aaff..17f4a468a 100644
--- a/CvGameCoreDLL_Expansion2/CvAIOperation.cpp
+++ b/CvGameCoreDLL_Expansion2/CvAIOperation.cpp
@@ -464,12 +464,12 @@ int CvAIOperation::GetArmyExpectedCityDamage(CvArmyAI* pArmy) const
 /// AI_AB_TEST (candidate, flag SiegeArmy): should this land city attack wait for more units? It should while its expected
 /// damage a turn is below the city's healing plus a fifth of its full HP (about 60 a turn for a 200 HP city, 80 with
 /// walls), for at most 20 turns after the operation started.
-bool CvAIOperation::IsArmyTooWeakForTarget(CvArmyAI* pArmy, bool bLog) const
+bool CvAIOperation::IsArmyTooWeakForTarget(CvArmyAI* pArmy, bool bLog, bool bIgnoreTimeLimit) const
 {
 	if (m_eType != AI_OPERATION_CITY_ATTACK_LAND || !GET_PLAYER(m_eOwner).UsesCandidateAI(FIX_SIEGE_ARMY))
 		return false;
 	CvCity* pCity = GetTargetPlot() ? GetTargetPlot()->getPlotCity() : NULL;
-	if (!pArmy || !pCity || GC.getGame().getGameTurn() - GetTurnStarted() >= 20)
+	if (!pArmy || !pCity || (!bIgnoreTimeLimit && GC.getGame().getGameTurn() - GetTurnStarted() >= 20))
 		return false;
 
 	//AI_AB_TEST (candidate, flag SiegeBar): a third of the city's HP instead of a fifth. In a test pair the fifth was met at
@@ -1615,6 +1615,17 @@ bool CvAIOperationMilitary::CheckTransitionToNextStage()
 		break;
 	case ARMYAISTATE_WAITING_FOR_UNITS_TO_REINFORCE:
 		{
+			//AI_AB_TEST (candidate, flag SiegeAbort): still too weak when SiegeArmy's 20 turns are up, so call it off instead of
+			//marching (a test game's attack marched at 27 of 60 a turn, declared on an equal neighbour and lost the army).
+			//The WAR approach stays, so a fresh attack forms and has to reach the bar before it can march or declare.
+			if (GET_PLAYER(m_eOwner).UsesCandidateAI(FIX_SIEGE_ABORT) && GC.getGame().getGameTurn() - GetTurnStarted() >= 20 &&
+				IsArmyTooWeakForTarget(pThisArmy, false, true))
+			{
+				LogOperationSpecialMessage("SiegeArmy: still too weak after 20 turns, giving up");
+				SetToAbort(AI_ABORT_TIMED_OUT);
+				return false;
+			}
+
 			//AI_AB_TEST (candidate, flag SiegeArmy): the required slots alone make a 4-5 unit army, which in test games never
 			//brought a quarter of the damage needed to take a city. Keep recruiting until it can, for up to 20 turns.
 			if(OperationalAIHelpers::HaveEnoughUnits(pThisArmy->GetSlotStatus(),0) && !IsArmyTooWeakForTarget(pThisArmy, true))
diff --git a/CvGameCoreDLL_Expansion2/CvAIOperation.h b/CvGameCoreDLL_Expansion2/CvAIOperation.h
index 93fcef961..faedbc0ed 100644
--- a/CvGameCoreDLL_Expansion2/CvAIOperation.h
+++ b/CvGameCoreDLL_Expansion2/CvAIOperation.h
@@ -206,7 +206,7 @@ public:
 	virtual bool RecruitUnit(CvUnit* pUnit);
 	virtual int GrabUnitsFromTheReserves(CvPlot* pMusterPlot, CvPlot* pTargetPlot, CvArmyAI* pArmy = NULL);
 	int GetArmyExpectedCityDamage(CvArmyAI* pArmy) const;
-	bool IsArmyTooWeakForTarget(CvArmyAI* pArmy, bool bLog = false) const;
+	bool IsArmyTooWeakForTarget(CvArmyAI* pArmy, bool bLog = false, bool bIgnoreTimeLimit = false) const;
 	virtual void UnitWasRemoved(int iArmyID, int iSlotID);
 	virtual CvPlot* ComputeTargetPlotForThisTurn(CvArmyAI* pArmy) const;
 
diff --git a/CvGameCoreDLL_Expansion2/CvPlayer.cpp b/CvGameCoreDLL_Expansion2/CvPlayer.cpp
index e4b00f987..befe73dff 100644
--- a/CvGameCoreDLL_Expansion2/CvPlayer.cpp
+++ b/CvGameCoreDLL_Expansion2/CvPlayer.cpp
@@ -33350,7 +33350,7 @@ static const CandidateFixInfo kCandidateFixes[] = {
 	{"Sanctions", false}, {"CoalitionPact", false}, {"DealReputation", false},
 	{"SiegeStay", false}, {"SiegePosture", false}, {"DeclareAtBorder", true},
 	{"UpgradeSaveCancel", true}, {"AirRebaseHeal", false},
-	{"SiegeArmy", false}, {"ArmyHandoff", false}, {"SiegeBar", false},
+	{"SiegeArmy", false}, {"ArmyHandoff", false}, {"SiegeBar", false}, {"SiegeAbort", false},
 };
 // one line per flag, and room in the 64-bit masks
 typedef char ABTestFixTableMatchesEnum[(sizeof(kCandidateFixes) / sizeof(kCandidateFixes[0]) == NUM_CANDIDATE_FIXES) ? 1 : -1];
diff --git a/CvGameCoreDLL_Expansion2/CvPlayer.h b/CvGameCoreDLL_Expansion2/CvPlayer.h
index 3834c37fa..eebf32259 100644
--- a/CvGameCoreDLL_Expansion2/CvPlayer.h
+++ b/CvGameCoreDLL_Expansion2/CvPlayer.h
@@ -199,6 +199,7 @@ enum CandidateFixTypes
 	FIX_SIEGE_ARMY,			// War: a land city attack keeps recruiting until it can take its city (up to 20 turns). Off in the bundle
 	FIX_ARMY_HANDOFF,		// War: units just delivered by an attack may reinforce its target from any zone. Off in the bundle
 	FIX_SIEGE_BAR,			// War: SiegeArmy waits for healing + a third of the city's HP a turn (not a fifth). Off in the bundle
+	FIX_SIEGE_ABORT,		// War: an attack still too weak after SiegeArmy's 20 turns is called off, not sent. Off in the bundle
 	NUM_CANDIDATE_FIXES
 };
 // AI_AB_TEST: a set of candidate flags, bit i = CandidateFixTypes i
-- 
