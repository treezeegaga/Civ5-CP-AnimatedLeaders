From 0c2d4cead5a8225a2d2f5afe0876682cb90c8e5b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 12:23:06 +0000
Subject: [PATCH] AI_AB_TEST War: flag SiegeBar (SiegeArmy waits for healing +
 a third of the city's HP; off in the bundle)

Logged siege pair 05D462A7: with the fifth-of-HP bar the attack waited, marched
and reached 92/200 expected damage a turn at the city, which held. SiegeBar
raises the bar to about 87 a turn for a 200 HP city (120 with walls). Only
matters with SiegeArmy on.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G2NZizcmgfGkXsgJcVcF7h
---
 CvGameCoreDLL_Expansion2/CvAIOperation.cpp | 5 ++++-
 CvGameCoreDLL_Expansion2/CvPlayer.cpp      | 2 +-
 CvGameCoreDLL_Expansion2/CvPlayer.h        | 1 +
 3 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/CvGameCoreDLL_Expansion2/CvAIOperation.cpp b/CvGameCoreDLL_Expansion2/CvAIOperation.cpp
index 500411bc4..cb47276e9 100644
--- a/CvGameCoreDLL_Expansion2/CvAIOperation.cpp
+++ b/CvGameCoreDLL_Expansion2/CvAIOperation.cpp
@@ -472,7 +472,10 @@ bool CvAIOperation::IsArmyTooWeakForTarget(CvArmyAI* pArmy, bool bLog) const
 	if (!pArmy || !pCity || GC.getGame().getGameTurn() - GetTurnStarted() >= 20)
 		return false;
 
-	int iNeeded = /*20*/ GD_INT_GET(CITY_HIT_POINTS_HEALED_PER_TURN) + pCity->GetMaxHitPoints() / 5;
+	//AI_AB_TEST (candidate, flag SiegeBar): a third of the city's HP instead of a fifth. In a test pair the fifth was met at
+	//the muster point, but at the city the siege peaked at 92 of 200 a turn and the city held
+	const int iHPDivisor = GET_PLAYER(m_eOwner).UsesCandidateAI(FIX_SIEGE_BAR) ? 3 : 5;
+	int iNeeded = /*20*/ GD_INT_GET(CITY_HIT_POINTS_HEALED_PER_TURN) + pCity->GetMaxHitPoints() / iHPDivisor;
 	int iExpected = GetArmyExpectedCityDamage(pArmy);
 	if (iExpected >= iNeeded)
 		return false;
diff --git a/CvGameCoreDLL_Expansion2/CvPlayer.cpp b/CvGameCoreDLL_Expansion2/CvPlayer.cpp
index 3ac0b74e2..7d5fd699d 100644
--- a/CvGameCoreDLL_Expansion2/CvPlayer.cpp
+++ b/CvGameCoreDLL_Expansion2/CvPlayer.cpp
@@ -33333,7 +33333,7 @@ static const CandidateFixInfo kCandidateFixes[] = {
 	{"GreedyArmyCap", false}, {"GreedyBook", true}, {"GreedyTarget", true}, {"CanWin", true}, {"ClosedBorders", true},
 	{"SiegeStay", false}, {"SiegePosture", false}, {"DeclareAtBorder", false},
 	{"UpgradeSaveCancel", false}, {"AirRebaseHeal", false},
-	{"SiegeArmy", false}, {"ArmyHandoff", false},
+	{"SiegeArmy", false}, {"ArmyHandoff", false}, {"SiegeBar", false},
 };
 // one line per flag, and room in the 64-bit masks
 typedef char ABTestFixTableMatchesEnum[(sizeof(kCandidateFixes) / sizeof(kCandidateFixes[0]) == NUM_CANDIDATE_FIXES) ? 1 : -1];
diff --git a/CvGameCoreDLL_Expansion2/CvPlayer.h b/CvGameCoreDLL_Expansion2/CvPlayer.h
index e87631b62..43fc29964 100644
--- a/CvGameCoreDLL_Expansion2/CvPlayer.h
+++ b/CvGameCoreDLL_Expansion2/CvPlayer.h
@@ -166,6 +166,7 @@ enum CandidateFixTypes
 	FIX_AIR_REBASE_HEAL,	// War (bug H2): healing aircraft stay in the quietest base. Off in the bundle
 	FIX_SIEGE_ARMY,			// War: a land city attack keeps recruiting until it can take its city (up to 20 turns). Off in the bundle
 	FIX_ARMY_HANDOFF,		// War: units just delivered by an attack may reinforce its target from any zone. Off in the bundle
+	FIX_SIEGE_BAR,			// War: SiegeArmy waits for healing + a third of the city's HP a turn (not a fifth). Off in the bundle
 	NUM_CANDIDATE_FIXES
 };
 // AI_AB_TEST: a set of candidate flags, bit i = CandidateFixTypes i
