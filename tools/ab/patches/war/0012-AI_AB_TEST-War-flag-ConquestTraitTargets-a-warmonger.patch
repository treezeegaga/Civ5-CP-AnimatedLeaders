From 18386e5e7df911fc9b40c5d9cc338bdad3b3377b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 15:05:08 +0000
Subject: [PATCH] AI_AB_TEST War: flag ConquestTraitTargets (a warmonger's
 conquest bonus shapes its targets; off in the bundle)

In CvDiplomacyAI, behind the flag:
- GetNewAIConquestTarget: Assyria (IsTechFromCityConquer) +5 per tech the
  target knows and it lacks, max +30; Songhai (GetPlunderModifier > 0) + half
  the target's population, max +30 (c4 target scores run about 10-70).
- CSConquest: Mongolia (GetCityStateCombatModifier > 0) accepts city-states
  up to STRENGTH_AVERAGE against it, not only STRENGTH_POOR.
- SelectBestApproachTowardsMinorCiv: civs that take city-states peacefully
  (IsAbleToAnnexCityStates / IsDiplomaticMarriage for Austria, IsNoAnnexing as
  Venice's marker) never choose war on a city-state they aren't fighting.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G2NZizcmgfGkXsgJcVcF7h
---
 CvGameCoreDLL_Expansion2/CvDiplomacyAI.cpp | 34 +++++++++++++++++++++-
 CvGameCoreDLL_Expansion2/CvPlayer.cpp      |  1 +
 CvGameCoreDLL_Expansion2/CvPlayer.h        |  1 +
 3 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/CvGameCoreDLL_Expansion2/CvDiplomacyAI.cpp b/CvGameCoreDLL_Expansion2/CvDiplomacyAI.cpp
index c9b471346..78d60ac29 100644
--- a/CvGameCoreDLL_Expansion2/CvDiplomacyAI.cpp
+++ b/CvGameCoreDLL_Expansion2/CvDiplomacyAI.cpp
@@ -23586,6 +23586,25 @@ PlayerTypes CvDiplomacyAI::GetNewAIConquestTarget(const char*& szReason)
 			iScore = (NUM_STRENGTH_VALUES - (int)eTheirStrength) * 10 + (eProximity == PLAYER_PROXIMITY_NEIGHBORS ? 5 : 0);
 		}
 
+		// AI_AB_TEST (candidate, flag ConquestTraitTargets): the conqueror's own spoils. Assyria takes a tech per city, so it
+		// favours targets that know what it lacks; Songhai triples capture gold, so it favours populous targets
+		if (!bExpansionist && pPlayer->UsesCandidateAI(FIX_CONQUEST_TRAIT_TARGETS))
+		{
+			const CvPlayerTraits* pTraits = pPlayer->GetPlayerTraits();
+			if (pTraits->IsTechFromCityConquer())
+			{
+				int iTechsWeLack = 0;
+				CvTeamTechs* pTheirTechs = GET_TEAM(GET_PLAYER(eLoopPlayer).getTeam()).GetTeamTechs();
+				CvTeamTechs* pOurTechs = GET_TEAM(pPlayer->getTeam()).GetTeamTechs();
+				for (int iTech = 0; iTech < GC.getNumTechInfos(); iTech++)
+					if (pTheirTechs->HasTech((TechTypes)iTech) && !pOurTechs->HasTech((TechTypes)iTech))
+						iTechsWeLack++;
+				iScore += min(30, iTechsWeLack * 5);
+			}
+			if (pTraits->GetPlunderModifier() > 0)
+				iScore += min(30, GET_PLAYER(eLoopPlayer).getTotalPopulation() / 2);
+		}
+
 		if (iScore > iBestScore)
 		{
 			iBestScore = iScore;
@@ -25202,6 +25221,18 @@ void CvDiplomacyAI::SelectBestApproachTowardsMinorCiv(PlayerTypes ePlayer)
 	// MILITARY TARGET VALUE - how tough is this guy to kill?
 	////////////////////////////////////
 
+	// AI_AB_TEST (candidate, flag ConquestTraitTargets): civs that take city-states peacefully (Austria by marriage, Venice
+	// with its merchant; NoAnnexing is Venice's marker in the base game) never conquer them
+	if (GetPlayer()->UsesCandidateAI(FIX_CONQUEST_TRAIT_TARGETS) && !IsAtWar(ePlayer))
+	{
+		const CvPlayerTraits* pTraits = GetPlayer()->GetPlayerTraits();
+		if (pTraits->IsAbleToAnnexCityStates() || pTraits->IsDiplomaticMarriage() || pTraits->IsNoAnnexing())
+		{
+			vApproachScores[CIV_APPROACH_WAR] = 0;
+			bPotentialWarTarget = false;
+		}
+	}
+
 	// Negative approach weights - cap at zero!
 	for (int iApproachLoop = 0; iApproachLoop < NUM_CIV_APPROACHES; iApproachLoop++)
 	{
@@ -25456,7 +25487,8 @@ void CvDiplomacyAI::SelectBestApproachTowardsMinorCiv(PlayerTypes ePlayer)
 	if (GetPlayer()->UsesCandidateAI(FIX_CS_CONQUEST) && GetPlayer()->IsCandidateWarmonger(FIX_TIMING_ATTACK) && !GetPlayer()->IsAtWarAnyMajor() &&
 		GetPlayer()->GetProximityToPlayer(ePlayer) >= PLAYER_PROXIMITY_CLOSE &&
 		GET_TEAM(GetTeam()).canDeclareWar(eTeam, eMyPlayer) && GetPlayer()->GetMilitaryAI()->HavePossibleAttackTarget(ePlayer) &&
-		(int)GetMilitaryStrengthComparedToUs(ePlayer) <= (int)STRENGTH_POOR)
+		(int)GetMilitaryStrengthComparedToUs(ePlayer) <= ((GetPlayer()->UsesCandidateAI(FIX_CONQUEST_TRAIT_TARGETS) &&
+			GetPlayer()->GetPlayerTraits()->GetCityStateCombatModifier() > 0) ? (int)STRENGTH_AVERAGE : (int)STRENGTH_POOR))
 	{
 		PlayerTypes eCSAlly = GET_PLAYER(ePlayer).GetMinorCivAI()->GetAlly();
 		bool bOk = eCSAlly == NO_PLAYER || IsAtWar(eCSAlly);
diff --git a/CvGameCoreDLL_Expansion2/CvPlayer.cpp b/CvGameCoreDLL_Expansion2/CvPlayer.cpp
index 8aa8df15d..cb63d6485 100644
--- a/CvGameCoreDLL_Expansion2/CvPlayer.cpp
+++ b/CvGameCoreDLL_Expansion2/CvPlayer.cpp
@@ -33364,6 +33364,7 @@ static const CandidateFixInfo kCandidateFixes[] = {
 	{"GreedyWarArmy", false},
 	{"GiftsNeedPatronage", true},
 	{"CSConquest", false},
+	{"ConquestTraitTargets", false},
 };
 // one line per flag, and room in the 64-bit masks
 typedef char ABTestFixTableMatchesEnum[(sizeof(kCandidateFixes) / sizeof(kCandidateFixes[0]) == NUM_CANDIDATE_FIXES) ? 1 : -1];
diff --git a/CvGameCoreDLL_Expansion2/CvPlayer.h b/CvGameCoreDLL_Expansion2/CvPlayer.h
index 445bd2469..1b806ccc2 100644
--- a/CvGameCoreDLL_Expansion2/CvPlayer.h
+++ b/CvGameCoreDLL_Expansion2/CvPlayer.h
@@ -226,6 +226,7 @@ enum CandidateFixTypes
 							// a diplomatic victory with the World Congress in session, an ally supplying a resource we'd lack, and
 							// an active gold or invest quest. In the bundle (the user ruled it obvious)
 	FIX_CS_CONQUEST,		// War: a warmonger in the conquest role goes to war on a weak, nearby, unguarded city-state. Off in the bundle
+	FIX_CONQUEST_TRAIT_TARGETS,// War: a warmonger's conquest bonus shapes its targets (Assyria, Songhai, Mongolia; Austria and Venice skip city-states). Off in the bundle
 	NUM_CANDIDATE_FIXES
 };
 // AI_AB_TEST: a set of candidate flags, bit i = CandidateFixTypes i
