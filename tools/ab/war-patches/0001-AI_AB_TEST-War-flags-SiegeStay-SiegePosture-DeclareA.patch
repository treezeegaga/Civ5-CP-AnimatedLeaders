-				ExecuteAttackWithUnits(pPlot, iMeleeCount>2 ? AL_HIGH : AL_MEDIUM);
+				//AI_AB_TEST: eMaxAggLvl is AL_HIGH except for the SiegePosture flag's safe-shots-only call
